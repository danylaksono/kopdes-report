# --- regenerable geodata downloads (see scripts/download_*.py to rebuild) ---
data/osm/
data/population/

# --- regenerable geo pipeline artifacts (see geo/README.md to rebuild) ---
geo/raw/
geo/geojson/
geo/output/

# --- regenerable web app data (see README.md to rebuild) ---
# Note the glob: `data/web/` would exclude the directory itself, and git cannot
# re-include a file whose parent directory is excluded, so the negations below
# would silently do nothing.
data/web/*
# ...except the analysis mart, which IS committed. It is the app's data layer -
# a GitHub Pages deploy 404s on its data otherwise - and it is small as parquet
# (6.5 MB for all 83,342 cooperatives, against 25 MB for the old points.geojson).
# Rebuild: python scripts/build_analysis_mart.py
!data/web/kopdes_points.parquet
!data/web/kopdes_kecamatan.parquet
!data/web/kopdes_kabupaten.parquet
!data/web/kopdes_provinsi.parquet
!data/web/mart_manifest.json
# Simplified admin polygons for /explore/ — context fills under the glyphs.
# Same reasoning: committed because the deployed app fetches them. 9.7 MB for
# all three levels, against 54 MB for the geo/output/ files they come from.
# Rebuild: python scripts/build_boundaries.py
!data/web/boundaries/
!data/web/boundaries/*.geojson

# --- report outputs that are per-record tables, not findings ---
# Everything else under reports/ IS committed - the small CSVs are the findings
# and must survive without a re-run. These are per-cooperative tables of 6-11 MB
# that each rebuild in ~1 min from their own report's run.py.
reports/03-population-coverage/kopdes_remoteness.csv
reports/05-road-access/kopdes_road_access.csv
reports/06-minimarket-proximity/kopdes_minimarket_distance.csv
reports/07-landuse-polygons/kopdes_landuse_context.csv
reports/08-exact-geometry/exact_minimarket_distance.csv
reports/10-coop-clustering/nn_distances.csv

# --- cached spatial indexes (rebuilt by the reports that use them) ---
data/osm/road_cells_h3r10.parquet
data/osm/indonesia_landuse.parquet

# --- dated SIMKOPDES snapshots: kept locally, not published as raw files ---
# The CSVs stay out of git (28 MB per pull). The manifests DO NOT - they are
# tiny, and their SHA-256 hashes are the only provenance record for snapshots
# that cannot be re-fetched, since the API only ever serves current state.
# Findings are published as pages; raw snapshots are available on request.
data/snapshots/**/*.csv

# --- Python ---
__pycache__/
*.pyc
.venv/
venv/

# --- Node ---
node_modules/
npm-debug.log*

# --- OS / editor cruft ---
.DS_Store
Thumbs.db

# --- local tool config ---
.claude/settings.local.json
